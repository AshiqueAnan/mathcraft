# Google Analytics 4 (GA4)
# Analytics are LIVE by default with the site's Measurement ID (G-SS92F2Q4PL), baked into the static build.
# Set this only if you want to override the default with a different property.
NEXT_PUBLIC_GA_ID=G-SS92F2Q4PL

# AI Tutor (optional — OFF by default). The site is 100% functional without these.
# When BOTH are set, the lesson pages add a Socratic AI tutor + unlimited "explain
# differently" analogies. Endpoint must be OpenAI-compatible:
#   /chat/completions is appended to NEXT_PUBLIC_LLM_ENDPOINT.
# NEVER commit a real key — provide it locally in .env.local.
NEXT_PUBLIC_LLM_ENDPOINT=
NEXT_PUBLIC_LLM_KEY=
